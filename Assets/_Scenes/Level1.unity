  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - 'You:

    "No way that''s one of the new Swarm Security Sweep (SSS) turrets..."'
  - "You: \n\"Once I get close enough to them, the camera's AI will do a deep scan
    of my face to unconstitutionally uncover all of my personal physical data! :D\""
  - "You: \n\"In other words, they'll shoot when they see me. I better watch out!\" "
  triggerOnStart: 0
  triggerOnce: 1
  dialoguePanel: {fileID: 569555928}
  dialogueText: {fileID: 1366621077}
